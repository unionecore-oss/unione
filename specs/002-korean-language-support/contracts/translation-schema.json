{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UNIONE Translation Dictionary Schema",
  "description": "JSON Schema for validating translation files (en.json, ko.json)",
  "type": "object",
  "required": ["common", "header", "footer", "pages"],
  "properties": {
    "common": {
      "type": "object",
      "description": "Common translations used across the entire site",
      "required": ["loading", "error", "buttons"],
      "properties": {
        "loading": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "buttons": {
          "type": "object",
          "required": ["submit", "cancel", "learnMore"],
          "properties": {
            "submit": { "type": "string", "minLength": 1 },
            "cancel": { "type": "string", "minLength": 1 },
            "learnMore": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "header": {
      "type": "object",
      "description": "Header component translations",
      "required": ["navigation", "cta", "languageSwitcher"],
      "properties": {
        "navigation": {
          "type": "object",
          "required": ["card", "platform", "aboutUs"],
          "properties": {
            "card": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "aboutUs": { "type": "string", "minLength": 1 }
          }
        },
        "cta": {
          "type": "object",
          "required": ["launchApp"],
          "properties": {
            "launchApp": { "type": "string", "minLength": 1 }
          }
        },
        "languageSwitcher": {
          "type": "object",
          "required": ["label", "currentLanguage"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "Accessible label for language switcher button"
            },
            "currentLanguage": {
              "type": "string",
              "minLength": 1,
              "description": "Template with {language} placeholder"
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "description": "Footer component translations",
      "required": ["company", "legal", "copyright"],
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1
        },
        "legal": {
          "type": "object",
          "required": ["privacyPolicy", "termsAndConditions"],
          "properties": {
            "privacyPolicy": { "type": "string", "minLength": 1 },
            "termsAndConditions": { "type": "string", "minLength": 1 }
          }
        },
        "copyright": {
          "type": "string",
          "minLength": 1,
          "description": "Template with {year} placeholder"
        }
      }
    },
    "pages": {
      "type": "object",
      "description": "Page-specific translations",
      "required": ["home", "card", "wallet", "earn", "reward", "aboutUs"],
      "properties": {
        "home": {
          "$ref": "#/definitions/homePage"
        },
        "card": {
          "$ref": "#/definitions/cardPage"
        },
        "wallet": {
          "$ref": "#/definitions/walletPage"
        },
        "earn": {
          "$ref": "#/definitions/earnPage"
        },
        "reward": {
          "$ref": "#/definitions/rewardPage"
        },
        "aboutUs": {
          "$ref": "#/definitions/aboutUsPage"
        }
      }
    }
  },
  "definitions": {
    "homePage": {
      "type": "object",
      "required": ["hero", "cardShowcase", "features"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "cardShowcase": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "features": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cardPage": {
      "type": "object",
      "required": ["hero", "howItWorks"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["title", "description", "cta"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "cta": { "type": "string", "minLength": 1 }
          }
        },
        "howItWorks": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "walletPage": {
      "type": "object",
      "required": ["hero", "security"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["title", "description", "cta"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "cta": { "type": "string", "minLength": 1 }
          }
        },
        "security": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "earnPage": {
      "type": "object",
      "required": ["hero"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "rewardPage": {
      "type": "object",
      "required": ["hero"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "aboutUsPage": {
      "type": "object",
      "required": ["hero", "values"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "values": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
